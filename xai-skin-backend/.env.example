MONGODB_URI=mongodb://localhost:27017/xai-skin-health
# Must stay the same across restarts; changing it invalidates existing app tokens until users log in again.
JWT_SECRET=your_jwt_secret_key_change_this_in_production
# Optional — access (short) and refresh (long) JWT lifetimes for /users/login and /users/refresh
# JWT_ACCESS_EXPIRES=15m
# JWT_REFRESH_EXPIRES=30d
MODEL_SERVER_URL=http://localhost:5000
